{
  "name": "nuimarkets/laravel-shared-utils",
  "description": "Common Laravel Classes",
  "type": "library",
  "license": "MIT",
  "authors": [
    {
      "name": "Nui Markets",
      "email": "developers@nuimarkets.com"
    }
  ],
  "minimum-stability": "stable",
  "prefer-stable": true,
  "require": {
    "php": "^8.3",
    "ext-gd": "*",
    "monolog/monolog": "^3.0",
    "laravel/framework": "^11.0|^12.0",
    "sentry/sentry-laravel": "^4.11",
    "guzzlehttp/guzzle": "^7.0",
    "swisnl/json-api-client": "^2.2",
    "aws/aws-sdk-php": "^3.342",
    "intervention/image": "^4.0",
    "symfony/process": "^7.0"
  },
  "suggest": {},
  "scripts": {
    "format": "pint",
    "lint": "pint --test || true",
    "test": "phpunit --filter",
    "test-all": "phpunit",
    "test-coverage": "phpunit --coverage-html coverage"
  },
  "require-dev": {
    "phpunit/phpunit": "^10.5|^11.0|^12.0",
    "orchestra/testbench": "^9.0|^10.0",
    "laravel/pint": "^1.0",
    "mockery/mockery": "^1.6"
  },
  "conflict": {
    "phpunit/phpunit": "<10.5.0"
  },
  "autoload": {
    "psr-4": {
      "NuiMarkets\\LaravelSharedUtils\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "NuiMarkets\\LaravelSharedUtils\\Tests\\": "tests/"
    }
  },
  "config": {
    "allow-plugins": {
      "php-http/discovery": true
    },
    "audit": {
      "ignore": {
        "CVE-2026-48019": "CRLF injection in Laravel's default email rule (GHSA-5vg9-5847-vvmq). Fixed in 12.60+/13.10+. The advisory's affected range is `<12.60.0`, so it covers the whole Laravel 11 line as well as 12.x below 12.60, and no 11.x patch is expected. Every test matrix leg pins Laravel 12, so `composer audit` reports this only on the prefer-lowest L12-below-12.60 leg. Remove once the Laravel floor is raised to 12.60+, which drops the 11.x line with it."
      }
    }
  }
}
